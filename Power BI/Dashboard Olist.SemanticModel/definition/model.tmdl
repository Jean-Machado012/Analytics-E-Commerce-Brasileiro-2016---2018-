model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_customers","dim_products","dim_sellers","fato_orders","fato_reviews","dim_calendario","dim_hora","Medidas"]

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop"]

ref table dim_customers
ref table dim_products
ref table dim_sellers
ref table fato_orders
ref table fato_reviews
ref table dim_calendario
ref table dim_hora
ref table Medidas

ref cultureInfo pt-BR

