	measure '# | Qtd Itens' = SUM(fato_orders[qtdItens])
		formatString: 0
		displayFolder: Gerais
		lineageTag: c992b67b-b00d-4249-aa9a-0b179a42d34c

	measure '$ | Faturamento' =
			
			VAR vPrecoFinal =
			SUMX(
			    fato_orders,
			    fato_orders[price] * fato_orders[qtdItens]
			)
			VAR vFreteFinal =
			SUMX(
			    fato_orders,
			    fato_orders[valor_frete] * fato_orders[qtdItens]
			)
			RETURN
			vPrecoFinal + vFreteFinal
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Gerais
		lineageTag: e279499b-01e2-4ac2-a7a3-da4b77172334

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '# | Qtd Ordens' = DISTINCTCOUNT(fato_orders[idOrder])
		formatString: 0
		displayFolder: Gerais
		lineageTag: d5a67226-75b3-49dd-af0e-c9d611bd649c

	measure '$ | Ticket Medio' =
			
			DIVIDE(
