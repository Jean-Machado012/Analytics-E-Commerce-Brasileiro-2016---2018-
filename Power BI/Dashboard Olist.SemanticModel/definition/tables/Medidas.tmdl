	measure '% | Taxa Recompra' = ```
			
			VAR vClienteRecorrente = 
			COUNTROWS(
			    FILTER(
			        VALUES(fato_orders[idCustomer]),
			        DISTINCTCOUNT(fato_orders[idOrder]) > 1
			    )
			)
			-- Os cliente únicos vão ser filtrados independente do tempo
			VAR vClienteUnicos = DISTINCTCOUNT(fato_orders[idCustomer])
			VAR vTxRecompra =
			DIVIDE(
			    vClienteRecorrente,
			    vClienteUnicos
			)
			RETURN
			vTxRecompra
			```
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: Gerais
		lineageTag: bff65c7d-8045-4ac8-865d-cb71a1d060f8

	measure '$ | Valor Medio Itens' = ```
			
			VAR vPreco =
			SUMX(
			    fato_orders,
			    fato_orders[price] * fato_orders[qtdItens]
			)
			VAR vItens = [# | Qtd Itens]
			VAR vValorMedio = 
			DIVIDE(
			    vPreco,
			    vItens
			)
			RETURN
			vValorMedio
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Gerais
		lineageTag: 1381eea5-6a91-4f3c-9b23-8884d09f66df

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '$ | Frete Medio Item' = ```
			
			VAR vFrete =
			SUMX(
			    fato_orders,
			    fato_orders[valor_frete] * fato_orders[qtdItens]
			)
			VAR vQtdFrete =
			COUNTX(
			    fato_orders,
			    COUNT(fato_orders[valor_frete]) * fato_orders[qtdItens]
			)
			VAR vFreteMedio = 
			DIVIDE(
			    vFrete,
			    vQtdFrete
			)
			RETURN
			vFreteMedio
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Gerais
		lineageTag: 0f0cd65a-81c6-4b06-aefd-340f1de7a513

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '$ | Frete Medio Pedido' =
			
			VAR vFrete =
			SUMX(
			    fato_orders,
			    fato_orders[valor_frete] * fato_orders[qtdItens]
			)
			VAR vPedidos = [# | Qtd Ordens]
			VAR vResultado =
			DIVIDE(
			    vFrete,
			    vPedidos
			)
			RETURN
			vResultado
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Gerais
		lineageTag: 8c9a2fb3-35f0-444d-bf06-d3d1e9da09ce

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '# | Qtd Clientes Ano' = DISTINCTCOUNT(fato_orders[idCustomer])
		formatString: #,0
		displayFolder: Gerais
		lineageTag: 51f53f19-5a31-42a8-ad58-a33792d8e25e

	measure '% | Variacao Faturamento Mensal' =
			
			VAR vMes = MONTH(MAX(dim_calendario[Data]))
			VAR vFatAtual = [$ | Faturamento]
			VAR vFatAnterior = [$ LM | Faturamento]
			RETURN
			IF(
			    vMes = 1,
			    0,
			    DIVIDE(
			        vFatAtual -vFatAnterior,
			        vFatAnterior
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Temporais
		lineageTag: 1ebb45b3-f823-4713-b254-ba2f7ed35ed3

	measure '% | Faturamento Anual' =
			
			DIVIDE(
			    [$ | Faturamento] - [$ LY | Faturamento],
			    [$ LY | Faturamento]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Temporais
		lineageTag: a1d8b844-21b2-4866-9cf7-b46b948743cf

	measure '% | Variacao Faturamento Mensal 2016' = ```
			
			VAR vMes = 
			CALCULATE(
			    MONTH(MIN(fato_orders[data_compra])),
			    YEAR(fato_orders[data_compra]) = 2016
			)
			VAR vFatAtual = 
			CALCULATE(
			    [$ | Faturamento],
			    YEAR(fato_orders[data_compra]) = 2016
			)
			VAR vFatAnterior = 
			CALCULATE(
			    vFatAtual,
			    PREVIOUSMONTH(fato_orders[data_compra])
			)
			RETURN
			IF(
			    vMes = 9,
			    0,
			    DIVIDE(
			        vFatAtual -vFatAnterior,
			        vFatAnterior
			    )
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Temporais
		lineageTag: 6f34cfb0-016d-45d1-a747-83dbab39568e

	measure '% | Variacao Faturamento Mensal 2017' = ```
			
			VAR vMes = MONTH(MAX(dim_calendario[Data]))
			VAR vFatAtual = 
			CALCULATE(
			    [$ | Faturamento],
			    dim_calendario[Ano] = 2017
			)
			VAR vFatAnterior = 
			CALCULATE(
			    vFatAtual,
			    PREVIOUSMONTH(dim_calendario[Data])
			)
			RETURN
			IF(
			    vMes = 1,
			    0,
			    DIVIDE(
			        vFatAtual -vFatAnterior,
			        vFatAnterior
			    )
			)
			```
		displayFolder: Temporais
		lineageTag: 73e87f13-cac3-4077-85bf-d23ae24d35fd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

