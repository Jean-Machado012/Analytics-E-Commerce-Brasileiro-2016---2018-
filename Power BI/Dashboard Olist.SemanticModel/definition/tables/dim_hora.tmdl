	column 'Hourly Quartile Sort'
		dataType: int64
		formatString: 0
		lineageTag: 3361d9b2-a186-429b-83da-23c85381e4f8
		summarizeBy: sum
		sourceColumn: Hourly Quartile Sort

		annotation SummarizationSetBy = Automatic

	partition dim_hora = m
		mode: import
		source = ```
				let
				    SecList = {0..86399},
				    SecTable = Table.FromList(SecList, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
				    SecType = Table.TransformColumnTypes(SecTable,{{"Column1", Int64.Type}}),
				    SecName = Table.RenameColumns(SecType,{{"Column1", "Segundo"}}),
				    TimeDurCol = Table.AddColumn(SecName,"TimeDuration", each #duration(0,0,0,[Segundo]), type duration),
				    TimeCol = Table.AddColumn(TimeDurCol, "Tempo", each #time(Duration.Hours([TimeDuration]),Duration.Minutes([TimeDuration]),Duration.Seconds([TimeDuration])), type time),
				    HourCol = Table.AddColumn(TimeCol, "Hora Número", each Time.Hour([Tempo]), Int64.Type),
				    MinuteCol = Table.AddColumn(HourCol, "Minuto Número", each Time.Minute([Tempo]), Int64.Type),
				    SecondCol = Table.AddColumn(MinuteCol, "Segundo Número", each Time.Second([Tempo]), Int64.Type),
				    HourMinuteCol = Table.AddColumn(SecondCol, "Hora Minuto", each #time([Hora Número],[Minuto Número],0), type time),
				    AMPMCol = Table.AddColumn(HourMinuteCol,"AMPM", each if [Segundo] < 43200 then "AM" else "PM", type text),
				    HourNmCol = Table.AddColumn(AMPMCol, "Hora", each 
				        if [Hora Número] = 0 then "12 AM"
				        else if [Hora Número] >= 1 and [Hora Número] <= 11 then Number.ToText([Hora Número]) & " AM" 
				        else if [Hora Número] = 12 then "12 PM"
				        else if [Hora Número] >= 13 then Number.ToText([Hora Número] - 12) & " PM"  
				        else "Unknown", type text),
				    HourlyQuartileCol = 
				        Table.AddColumn(HourNmCol, "Hourly Quartile", each 
				            if        [Hora Número] >= 0 and [Hora Número] <= 5 then "12AM to 6AM"
				            else if   [Hora Número] >= 6 and [Hora Número] <= 11 then "6AM to 12PM"
				            else if   [Hora Número] >= 12 and [Hora Número] <= 17  then "12PM to 6PM"
				            else if   [Hora Número] >= 18 and [Hora Número] <= 23 then "6PM to 12AM"
				            else "Unknown", type text
				            ),
				    HourlyQuartileSortCol = 
				        Table.AddColumn(HourlyQuartileCol, "Hourly Quartile Sort", each 
				            if        [Hora Número] >= 0 and [Hora Número] <= 5 then 1
				            else if   [Hora Número] >= 6 and [Hora Número] <= 11 then 2
				            else if   [Hora Número] >= 12 and [Hora Número] <= 17  then 3
				            else if   [Hora Número] >= 18 and [Hora Número] <= 23 then 4
				            else 5, Int64.Type
				        )
				in
				    HourlyQuartileSortCol
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

